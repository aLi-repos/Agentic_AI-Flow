# Agentflow_AI Environment Configuration

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB Database URI (Leave empty to use automatic embedded in-memory MongoDB)
MONGODB_URI=

# Redis URI for BullMQ (Leave as redis://localhost:6379 or leave empty for automatic in-memory queue fallback)
REDIS_URL=redis://localhost:6379

# Authentication & Cryptography
JWT_SECRET=
JWT_EXPIRES_IN=
CREDENTIAL_ENCRYPTION_KEY=

# AI Providers (Optional - Deterministic rule engine is used if omitted)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
